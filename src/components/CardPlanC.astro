---
interface Props {
  id: string;
  title: string;
  description: string;
  detailText: string;
  url: string;
  image?: string;
  type: 'BOOTH' | 'Web' | 'Spreadsheet';
  index: number;
}

const { id, title, description, detailText, url, image, type, index } = Astro.props;
---

<div class="stack-card glass" data-index={index}>
  <div class="card-layout">
    <div class="card-left">
      <div class="card-image-wrap">
        {image ? (
          <div class="card-image" style={`background-image: url('${image}')`}></div>
        ) : (
          <div class="card-image placeholder"></div>
        )}
      </div>
    </div>
    
    <div class="card-right">
      <span class={`tag tag-${type.toLowerCase()}`}>{type}</span>
      <h2>{title}</h2>
      
      <!-- 常に表示される簡易説明 -->
      <p class="short-desc">{description}</p>
      
      <!-- アクティブ時のみ表示される詳細 -->
      <div class="active-details">
        <div class="detail-desc">
          {detailText.split('\n').map((line) => (
            <p>{line}</p>
          ))}
        </div>
        <div class="detail-actions">
          <a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">公開ページへ ↗</a>
          <a href="#" target="_blank" class="btn btn-secondary">FANBOX</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .stack-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    padding: 2rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    
    /* 3Dトランジション設定 */
    transition: all 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
    opacity: 0;
    transform: translateY(40px) scale(0.9);
    pointer-events: none;
    z-index: 1;
    border: 1px solid var(--glass-border);
  }

  /* JavaScriptで制御されるクラス */
  :global(.stack-card.active) {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    z-index: 10;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
  }
  :global([data-theme='dark'] .stack-card.active) {
    box-shadow: 0 20px 50px rgba(0,0,0,0.6);
  }

  :global(.stack-card.prev) {
    opacity: 0.7;
    transform: translateY(-30px) scale(0.95);
    z-index: 5;
    pointer-events: auto;
    cursor: pointer;
  }
  
  :global(.stack-card.next) {
    opacity: 0.7;
    transform: translateY(30px) scale(0.95);
    z-index: 5;
    pointer-events: auto;
    cursor: pointer;
  }
  
  :global(.stack-card.prev:hover), :global(.stack-card.next:hover) {
    opacity: 0.9;
  }

  .card-layout {
    display: flex;
    gap: 2rem;
    height: 100%;
  }

  .card-left {
    flex: 0 0 40%;
    display: flex;
    flex-direction: column;
  }

  .card-image-wrap {
    flex-grow: 1;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--glass-border);
  }
  .card-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
  }
  .placeholder {
    background: rgba(0,0,0,0.05);
  }
  [data-theme='dark'] .placeholder {
    background: rgba(255,255,255,0.05);
  }

  .card-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow-y: auto;
  }

  .tag {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: white;
  }
  .tag-booth { background: var(--tag-booth); }
  .tag-web { background: var(--tag-web); }
  .tag-spreadsheet { background: var(--tag-spreadsheet); }

  h2 {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .short-desc {
    margin: 0;
    font-size: 1rem;
    opacity: 0.9;
    line-height: 1.5;
  }

  /* 非アクティブ時は詳細を隠す */
  .active-details {
    display: none;
    opacity: 0;
    animation: fadeIn 0.5s ease forwards;
    animation-delay: 0.2s;
  }
  
  :global(.stack-card.active) .active-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .detail-desc {
    margin-top: 1rem;
    flex-grow: 1;
  }
  .detail-desc p {
    line-height: 1.6;
    margin-bottom: 0.8rem;
    opacity: 0.9;
  }

  .detail-actions {
    display: flex;
    gap: 10px;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .btn {
    padding: 0.8rem 1.2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.9rem;
    transition: transform 0.2s, filter 0.2s;
  }
  .btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .btn-primary {
    background: var(--text-color);
    color: var(--bg-gradient);
  }
  [data-theme='dark'] .btn-primary {
    background: #fff;
    color: #000;
  }
  .btn-secondary {
    background: rgba(0,0,0,0.05);
    color: var(--text-color);
    border: 1px solid var(--glass-border);
  }
  [data-theme='dark'] .btn-secondary {
    background: rgba(255,255,255,0.05);
  }

  @media (max-width: 768px) {
    .card-layout {
      flex-direction: column;
    }
    .card-left {
      flex: 0 0 150px;
    }
  }
</style>
