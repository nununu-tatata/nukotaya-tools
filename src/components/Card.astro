---
interface Props {
  id: string; // 一意のID
  title: string;
  description: string; // カードに表示される短い説明
  detailText: string; // 展開時に表示される詳細な説明（改行込み）
  url: string; // 本番公開先URL
  image?: string;
  type: 'BOOTH' | 'Web' | 'Spreadsheet';
}

const { id, title, description, detailText, url, image, type } = Astro.props;
---

<div class="card glass" id={`card-${id}`} aria-expanded="false" tabindex="0">
  
  <!-- 常に表示されるサマリー部分 -->
  <div class="card-summary">
    <div class="summary-text">
      <span class={`tag tag-${type.toLowerCase()}`}>{type}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="expand-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </div>

  <!-- クリックで「にょきっ」と展開する詳細部分 -->
  <div class="accordion-details">
    <div class="accordion-inner">
      
      {image && <img src={image} alt={title} class="detail-image" />}
      
      <div class="detail-desc">
        {detailText.split('\n').map((line) => (
          <p>{line}</p>
        ))}
      </div>

      <div class="detail-actions">
        <!-- 本番URL -->
        <a href={url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">公開ページへ ↗</a>
        <!-- ダミーURLボタン -->
        <a href="#" target="_blank" class="btn btn-secondary" onclick="event.stopPropagation()">🎁 FANBOXで支援・おまけ</a>
        <a href="#" target="_blank" class="btn btn-secondary" onclick="event.stopPropagation()">💬 X (Twitter) での解説</a>
      </div>
      
    </div>
  </div>
</div>

<script>
  // アコーディオンのトグル処理
  const cards = document.querySelectorAll('.card');

  cards.forEach(card => {
    // クリックで展開・折りたたみ
    card.addEventListener('click', (e) => {
      // リンクやボタンをクリックした時はアコーディオンを切り替えない
      const target = e.target as HTMLElement;
      if (target.closest('a') || target.closest('button')) {
        return;
      }

      const isExpanded = card.getAttribute('aria-expanded') === 'true';
      
      // 他の開いているカードを閉じる場合（任意設定。今回は同時に複数開ける仕様でもOK）
      // cards.forEach(c => c.setAttribute('aria-expanded', 'false'));
      
      card.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
    });

    // Enterキーでも開けるようにする（アクセシビリティ対応）
    card.addEventListener('keydown', (e) => {
      const keyboardEvent = e as KeyboardEvent;
      if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
        keyboardEvent.preventDefault();
        const isExpanded = card.getAttribute('aria-expanded') === 'true';
        card.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
      }
    });
  });
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-align: left;
    color: inherit;
    position: relative;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
    margin: 0;
    overflow: hidden; /* 子要素のはみ出しを防ぐ */
  }
  
  .card:hover, .card:focus-visible {
    box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.15);
  }
  [data-theme='dark'] .card:hover {
    box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.5);
  }

  .card-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    gap: 1rem;
  }

  .summary-text {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .expand-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s;
  }
  [data-theme='dark'] .expand-icon {
    background: rgba(255, 255, 255, 0.1);
  }
  .card[aria-expanded="true"] .expand-icon {
    transform: rotate(180deg);
    background: rgba(0, 0, 0, 0.1);
  }
  [data-theme='dark'] .card[aria-expanded="true"] .expand-icon {
    background: rgba(255, 255, 255, 0.2);
  }

  .expand-icon svg {
    width: 20px;
    height: 20px;
    color: var(--text-color);
  }

  .tag {
    align-self: flex-start;
    padding: 0.2rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: white;
  }

  .tag-booth { background: var(--tag-booth); }
  .tag-web { background: var(--tag-web); }
  .tag-spreadsheet { background: var(--tag-spreadsheet); }

  .summary-text h2 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .summary-text p {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.8;
    line-height: 1.5;
  }

  /* ==== アコーディオン展開アニメーション ==== */
  .accordion-details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card[aria-expanded="true"] .accordion-details {
    grid-template-rows: 1fr;
  }

  .accordion-inner {
    overflow: hidden;
    padding: 0 1.5rem; /* 初期状態では上下パディング0、開いた時に確保する */
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease, padding 0.3s ease;
  }

  .card[aria-expanded="true"] .accordion-inner {
    padding: 0 1.5rem 1.5rem 1.5rem;
    opacity: 1;
  }

  /* 展開時のコンテンツ */
  .detail-image {
    width: 100%;
    max-height: 300px;
    object-fit: cover;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
  }

  .detail-desc p {
    margin: 0 0 1rem 0;
    line-height: 1.6;
    font-size: 1rem;
    opacity: 0.9;
  }

  .detail-desc p:last-child {
    margin-bottom: 0;
  }
  
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 0.5rem;
  }
  
  .btn {
    flex: 1 1 200px;
    display: block;
    text-align: center;
    padding: 1rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.95rem;
    transition: transform 0.2s, filter 0.2s;
  }
  .btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }
  .btn-primary {
    background: var(--text-color);
    color: var(--bg-gradient);
  }
  [data-theme='dark'] .btn-primary {
    background: #fff;
    color: #000;
  }
  .btn-secondary {
    background: rgba(0,0,0,0.05);
    color: var(--text-color);
    border: 1px solid var(--glass-border);
  }
  [data-theme='dark'] .btn-secondary {
    background: rgba(255,255,255,0.05);
  }
</style>
