---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    id: 'log-checker',
    title: 'CoC成長チェックツール',
    description: 'Tekeyやココフォリアのログから技能の成長を自動判定・集計するツールです。',
    detailText: 'Tekeyやココフォリアのログをドラッグ＆ドロップするだけで、技能の成長（CL・FB・S・初期値など）を自動判定・集計するツールです。スマホ対応！\n６版のTekey（v2）とココフォリアのログに対応。様々なオプションで好きな成長をチェックしテキスト出力可能です。',
    url: 'https://nununu-tatata.github.io/log-checker/',
    type: 'Web',
    image: 'https://nununu-tatata.github.io/log-checker/ogp.png'
  },
  {
    id: 'keypale',
    title: 'KeyPale',
    description: 'Tekey向けチャパレ編集エディタ。素早く快適にチャパレを編集。',
    detailText: 'KeyPaleはTekeyでのオンラインセッションをより快適にするためのデスクトップアプリケーションです。\n直感的な操作とショートカットキーを駆使して、チャットパレットの作成や編集を爆速で行えます。',
    url: 'https://alpha.booth.pm/items/7976314',
    type: 'BOOTH'
  },
  {
    id: 'backup-kun',
    title: 'CoC6版CS バックアップくん',
    description: '保管所のデータをスプレッドシートに自動バックアップ。',
    detailText: '現在作成中のスプレッドシートツールです。\nキャラクター保管所に登録しているCoC6版のキャラクターシートのデータを、安全にスプレッドシートにバックアップ・管理することができます。',
    url: 'https://x.com/nukonuko_4/status/2057406689859838067',
    type: 'Spreadsheet'
  },
  {
    id: '404-tool',
    title: 'CoCチャパレ＆コマ作成',
    description: 'ブラウザ上で素早くココフォリア用のコマやチャットパレットを生成。',
    detailText: 'ブラウザ上で動作するWEBツールです。\n必要なステータスを入力するだけで、ココフォリアにそのまま流し込める形式のコマデータやチャットパレットを簡単に作成できます。',
    url: 'https://nununu-tatata.github.io/404-tool/',
    type: 'Web'
  },
  {
    id: 'tecopi',
    title: 'TECOPI',
    description: 'テキスト送信支援ツール。よく使う定型文を手軽にコピペ＆送信。',
    detailText: 'TECOPI（テキスト送信支援ツール）は、セッション中によく使う描写や定型文をあらかじめ登録しておき、必要な時にワンクリックで呼び出して送信できるBOOTH配布ツールです。\nKP（キーパー）の負担を大きく軽減します。',
    url: 'https://alpha.booth.pm/items/8544644',
    type: 'BOOTH'
  }
];
---

<Layout title="ぬこた屋ツールズ (アイデア1)">
  <div class="page-title">
    <h2>💡 アイデア1: 横スクロール・スナップ型</h2>
    <p>横にスワイプして探し、クリックで直下に巨大パネルを展開するNetflixスタイル。</p>
  </div>

  <div class="idea1-container">
    <!-- 横スクロールエリア -->
    <div class="horizontal-scroll">
      {tools.map((tool) => (
        <button class="h-card glass" data-target={`details-${tool.id}`}>
          <div class="h-card-img" style={tool.image ? `background-image:url(${tool.image})` : 'background:rgba(0,0,0,0.05)'}></div>
          <div class="h-card-body">
            <span class={`tag tag-${tool.type.toLowerCase()}`}>{tool.type}</span>
            <h3>{tool.title}</h3>
          </div>
        </button>
      ))}
    </div>

    <!-- 展開される詳細パネルエリア -->
    <div class="details-stage">
      {tools.map((tool) => (
        <div id={`details-${tool.id}`} class="stage-panel glass hidden">
          <button class="close-stage" aria-label="閉じる">×</button>
          <div class="stage-layout">
            {tool.image && (
              <div class="stage-left">
                <img src={tool.image} alt={tool.title} class="stage-image" />
              </div>
            )}
            <div class="stage-right">
              <h2>{tool.title}</h2>
              <span class={`tag tag-${tool.type.toLowerCase()}`}>{tool.type}</span>
              <div class="stage-desc">
                {tool.detailText.split('\n').map(line => <p>{line}</p>)}
              </div>
              <div class="stage-actions">
                <a href={tool.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">公開ページへ ↗</a>
                <a href="#" class="btn btn-secondary">🎁 FANBOX</a>
                <a href="#" class="btn btn-secondary">💬 X解説</a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="nav-links">
    <a href="/idea-2" class="glass">アイデア2 (ドック型) を見る →</a>
    <a href="/idea-3" class="glass">アイデア3 (ジグザグ型) を見る →</a>
  </div>
</Layout>

<script>
  const cards = document.querySelectorAll('.h-card');
  const panels = document.querySelectorAll('.stage-panel');
  let activePanel: HTMLElement | null = null;
  let activeCard: HTMLElement | null = null;

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const targetId = card.getAttribute('data-target');
      const panel = document.getElementById(targetId as string);
      
      // 選択状態のリセット
      cards.forEach(c => c.classList.remove('active'));
      
      if (activePanel && activePanel !== panel) {
        activePanel.classList.remove('open');
      }

      if (panel?.classList.contains('open')) {
        panel.classList.remove('open');
        activePanel = null;
        activeCard = null;
      } else if (panel) {
        panel.classList.add('open');
        card.classList.add('active');
        activePanel = panel;
        activeCard = card as HTMLElement;
        
        // スクロールで追従
        setTimeout(() => {
          panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
      }
    });
  });

  const closeBtns = document.querySelectorAll('.close-stage');
  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (activePanel) {
        activePanel.classList.remove('open');
        activeCard?.classList.remove('active');
        activePanel = null;
        activeCard = null;
      }
    });
  });
</script>

<style>
  .page-title { text-align: center; margin-bottom: 2rem; }
  .page-title h2 { margin-bottom: 0.5rem; }

  .idea1-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 10;
  }

  /* 横スクロールエリア */
  .horizontal-scroll {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1.5rem;
    padding: 1rem 1rem 2rem;
    -ms-overflow-style: none; /* IE/Edge */
    scrollbar-width: none; /* Firefox */
  }
  .horizontal-scroll::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .h-card {
    flex: 0 0 280px;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    padding: 0;
    border: none;
    cursor: pointer;
    border-radius: 16px;
    transition: transform 0.2s, box-shadow 0.2s;
    text-align: left;
    outline: 2px solid transparent;
  }
  .h-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  .h-card.active {
    outline: 3px solid var(--text-color);
    transform: scale(0.98);
  }

  .h-card-img {
    height: 140px;
    width: 100%;
    background-size: cover;
    background-position: center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom: 1px solid var(--glass-border);
  }
  .h-card-body {
    padding: 1rem;
  }
  .h-card-body h3 {
    margin: 0.5rem 0 0 0;
    font-size: 1.1rem;
    font-weight: 800;
  }
  
  .tag {
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: white;
  }
  .tag-booth { background: var(--tag-booth); }
  .tag-web { background: var(--tag-web); }
  .tag-spreadsheet { background: var(--tag-spreadsheet); }

  /* 展開ステージ */
  .details-stage {
    margin: 1rem auto 4rem;
    max-width: 1000px;
  }

  .stage-panel {
    display: none;
    opacity: 0;
    animation: slideDown 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    padding: 2rem;
    position: relative;
    border-radius: 24px;
  }
  .stage-panel.open {
    display: block;
  }
  
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .close-stage {
    position: absolute;
    top: 15px;
    right: 20px;
    background: transparent;
    border: none;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.5;
  }

  .stage-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }
  .stage-left { flex: 0 0 300px; }
  .stage-image {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
  }
  .stage-right { flex: 1; display: flex; flex-direction: column; gap: 0.5rem; }
  .stage-right h2 { margin: 0; font-size: 1.8rem; font-weight: 800; }
  .stage-desc { margin-top: 1rem; line-height: 1.6; opacity: 0.9; }

  .stage-actions {
    display: flex;
    gap: 10px;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .btn {
    padding: 0.8rem 1.2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.9rem;
    transition: transform 0.2s, filter 0.2s;
  }
  .btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
  .btn-primary { background: var(--text-color); color: var(--bg-gradient); }
  [data-theme='dark'] .btn-primary { background: #fff; color: #000; }
  .btn-secondary { background: rgba(0,0,0,0.05); color: var(--text-color); border: 1px solid var(--glass-border); }
  [data-theme='dark'] .btn-secondary { background: rgba(255,255,255,0.05); }

  @media (max-width: 768px) {
    .stage-layout { flex-direction: column; }
    .stage-left { flex: auto; width: 100%; }
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }
  .nav-links a {
    padding: 1rem 2rem;
    text-decoration: none;
    color: var(--text-color);
    font-weight: 800;
  }
</style>
