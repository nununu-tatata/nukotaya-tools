---
import Layout from '../layouts/Layout.astro';
import CardPlanC from '../components/CardPlanC.astro';
---

<Layout title="ぬこた屋ツールズ (案C)">
  <div class="page-title">
    <h2>案C: フローティング・スタック型</h2>
    <p>カードが奥に重なるスタックレイアウト。クリックで前のカードを切り替えます。</p>
  </div>

  <div class="stack-container">
    <div id="stack-wrapper">
      <CardPlanC 
        id="log-checker"
        index={0}
        title="CoC成長チェックツール"
        description="Tekeyやココフォリアのログから技能の成長を自動判定・集計するツールです。"
        detailText={`Tekeyやココフォリアのログをドラッグ＆ドロップするだけで、技能の成長（CL・FB・S・初期値など）を自動判定・集計するツールです。スマホ対応！\n６版のTekey（v2）とココフォリアのログに対応。様々なオプションで好きな成長をチェックしテキスト出力可能です。`}
        url="https://nununu-tatata.github.io/log-checker/"
        type="Web"
        image="https://nununu-tatata.github.io/log-checker/ogp.png"
      />

      <CardPlanC 
        id="keypale"
        index={1}
        title="KeyPale"
        description="Tekey向けチャパレ編集エディタ。素早く快適にチャパレを編集。"
        detailText={`KeyPaleはTekeyでのオンラインセッションをより快適にするためのデスクトップアプリケーションです。\n直感的な操作とショートカットキーを駆使して、チャットパレットの作成や編集を爆速で行えます。`}
        url="https://alpha.booth.pm/items/7976314"
        type="BOOTH"
      />

      <CardPlanC 
        id="backup-kun"
        index={2}
        title="CoC6版CS バックアップくん"
        description="保管所のデータをスプレッドシートに自動バックアップ。"
        detailText={`現在作成中のスプレッドシートツールです。\nキャラクター保管所に登録しているCoC6版のキャラクターシートのデータを、安全にスプレッドシートにバックアップ・管理することができます。`}
        url="https://x.com/nukonuko_4/status/2057406689859838067"
        type="Spreadsheet"
      />

      <CardPlanC 
        id="404-tool"
        index={3}
        title="CoCチャパレ＆コマ作成"
        description="ブラウザ上で素早くココフォリア用のコマやチャットパレットを生成。"
        detailText={`ブラウザ上で動作するWEBツールです。\n必要なステータスを入力するだけで、ココフォリアにそのまま流し込める形式のコマデータやチャットパレットを簡単に作成できます。`}
        url="https://nununu-tatata.github.io/404-tool/"
        type="Web"
      />

      <CardPlanC 
        id="tecopi"
        index={4}
        title="TECOPI"
        description="テキスト送信支援ツール。よく使う定型文を手軽にコピペ＆送信。"
        detailText={`TECOPI（テキスト送信支援ツール）は、セッション中によく使う描写や定型文をあらかじめ登録しておき、必要な時にワンクリックで呼び出して送信できるBOOTH配布ツールです。\nKP（キーパー）の負担を大きく軽減します。`}
        url="https://alpha.booth.pm/items/8544644"
        type="BOOTH"
      />
    </div>
    
    <div class="stack-controls">
      <button id="btn-prev" class="btn btn-secondary glass">↑ 前のツール</button>
      <button id="btn-next" class="btn btn-secondary glass">次のツール ↓</button>
    </div>
  </div>

  <div class="nav-links">
    <a href="/plan-b" class="glass">← 案B (グリッド) に戻る</a>
    <a href="/" class="glass">案A (トップ) に戻る</a>
  </div>
</Layout>

<script>
  // スタックの制御スクリプト
  const cards = document.querySelectorAll('.stack-card');
  const totalCards = cards.length;
  let activeIndex = 0;

  function updateStack() {
    cards.forEach((card) => {
      const idx = parseInt(card.getAttribute('data-index') || '0');
      
      // 全てのクラスをクリア
      card.classList.remove('active', 'prev', 'next');
      
      if (idx === activeIndex) {
        card.classList.add('active');
      } else if (idx === (activeIndex - 1 + totalCards) % totalCards) {
        card.classList.add('prev');
      } else if (idx === (activeIndex + 1) % totalCards) {
        card.classList.add('next');
      }
    });
  }

  // 初期化
  updateStack();

  // カードクリックでの遷移
  cards.forEach(card => {
    card.addEventListener('click', (e) => {
      if (card.classList.contains('active')) return;
      
      const idx = parseInt(card.getAttribute('data-index') || '0');
      activeIndex = idx;
      updateStack();
    });
  });

  // コントロールボタンでの遷移
  document.getElementById('btn-prev')?.addEventListener('click', () => {
    activeIndex = (activeIndex - 1 + totalCards) % totalCards;
    updateStack();
  });
  
  document.getElementById('btn-next')?.addEventListener('click', () => {
    activeIndex = (activeIndex + 1) % totalCards;
    updateStack();
  });
</script>

<style>
  .page-title {
    max-width: 1000px;
    margin: 0 auto 2rem;
    padding: 0 2rem;
    text-align: center;
  }
  .page-title h2 {
    margin-bottom: 0.5rem;
  }

  .stack-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto 4rem;
    padding: 0 2rem;
    z-index: 10;
  }

  #stack-wrapper {
    position: relative;
    height: 500px; /* カードの高さ分確保 */
    width: 100%;
    margin-bottom: 2rem;
    perspective: 1000px;
  }

  @media (max-width: 768px) {
    #stack-wrapper {
      height: 600px;
    }
  }

  .stack-controls {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  
  .stack-controls button {
    cursor: pointer;
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }
  .nav-links a {
    padding: 1rem 2rem;
    text-decoration: none;
    color: var(--text-color);
    font-weight: 800;
  }
  .nav-links a:hover {
    transform: translateY(-2px);
  }
</style>
