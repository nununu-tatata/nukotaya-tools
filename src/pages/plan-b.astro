---
import Layout from '../layouts/Layout.astro';
import CardPlanB from '../components/CardPlanB.astro';
---

<Layout title="ぬこた屋ツールズ (案B)">
  <div class="page-title">
    <h2>案B: グリッド展開型（Google画像検索スタイル）</h2>
    <p>カードをクリックすると、その行の下に全幅の詳細パネルが開きます。</p>
  </div>

  <div class="grid-layout">
    <CardPlanB 
      id="log-checker"
      title="CoC成長チェックツール"
      description="Tekeyやココフォリアのログから技能の成長を自動判定・集計するツールです。"
      detailText={`Tekeyやココフォリアのログをドラッグ＆ドロップするだけで、技能の成長（CL・FB・S・初期値など）を自動判定・集計するツールです。スマホ対応！\n６版のTekey（v2）とココフォリアのログに対応。様々なオプションで好きな成長をチェックしテキスト出力可能です。`}
      url="https://nununu-tatata.github.io/log-checker/"
      type="Web"
      image="https://nununu-tatata.github.io/log-checker/ogp.png"
    />

    <CardPlanB 
      id="keypale"
      title="KeyPale"
      description="Tekey向けチャパレ編集エディタ。素早く快適にチャパレを編集。"
      detailText={`KeyPaleはTekeyでのオンラインセッションをより快適にするためのデスクトップアプリケーションです。\n直感的な操作とショートカットキーを駆使して、チャットパレットの作成や編集を爆速で行えます。`}
      url="https://alpha.booth.pm/items/7976314"
      type="BOOTH"
    />

    <CardPlanB 
      id="backup-kun"
      title="CoC6版CS バックアップくん"
      description="保管所のデータをスプレッドシートに自動バックアップ。"
      detailText={`現在作成中のスプレッドシートツールです。\nキャラクター保管所に登録しているCoC6版のキャラクターシートのデータを、安全にスプレッドシートにバックアップ・管理することができます。`}
      url="https://x.com/nukonuko_4/status/2057406689859838067"
      type="Spreadsheet"
    />

    <CardPlanB 
      id="404-tool"
      title="CoCチャパレ＆コマ作成"
      description="ブラウザ上で素早くココフォリア用のコマやチャットパレットを生成。"
      detailText={`ブラウザ上で動作するWEBツールです。\n必要なステータスを入力するだけで、ココフォリアにそのまま流し込める形式のコマデータやチャットパレットを簡単に作成できます。`}
      url="https://nununu-tatata.github.io/404-tool/"
      type="Web"
    />

    <CardPlanB 
      id="tecopi"
      title="TECOPI"
      description="テキスト送信支援ツール。よく使う定型文を手軽にコピペ＆送信。"
      detailText={`TECOPI（テキスト送信支援ツール）は、セッション中によく使う描写や定型文をあらかじめ登録しておき、必要な時にワンクリックで呼び出して送信できるBOOTH配布ツールです。\nKP（キーパー）の負担を大きく軽減します。`}
      url="https://alpha.booth.pm/items/8544644"
      type="BOOTH"
    />
  </div>

  <div class="nav-links">
    <a href="/" class="glass">← 案A (アコーディオン) に戻る</a>
    <a href="/plan-c" class="glass">案C (スタック) を見る →</a>
  </div>
</Layout>

<script>
  const cards = document.querySelectorAll('.plan-b-card');
  let activeDetails: HTMLElement | null = null;
  let activeCard: HTMLElement | null = null;

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const targetId = card.getAttribute('data-target');
      const details = document.getElementById(targetId as string);
      
      if (!details) return;

      if (activeDetails && activeDetails !== details) {
        activeDetails.classList.remove('open');
        activeCard?.setAttribute('aria-expanded', 'false');
      }

      if (details.classList.contains('open')) {
        details.classList.remove('open');
        card.setAttribute('aria-expanded', 'false');
        activeDetails = null;
        activeCard = null;
      } else {
        details.classList.add('open');
        card.setAttribute('aria-expanded', 'true');
        activeDetails = details;
        activeCard = card as HTMLElement;
        
        // 少しスクロールして見やすくする
        setTimeout(() => {
          details.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 400);
      }
    });
  });

  const closeBtns = document.querySelectorAll('.close-details');
  closeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (activeDetails) {
        activeDetails.classList.remove('open');
        activeCard?.setAttribute('aria-expanded', 'false');
        activeDetails = null;
        activeCard = null;
      }
    });
  });
</script>

<style>
  .page-title {
    max-width: 1000px;
    margin: 0 auto 2rem;
    padding: 0 2rem;
    text-align: center;
  }
  .page-title h2 {
    margin-bottom: 0.5rem;
  }

  .grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    position: relative;
    z-index: 10;
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }
  .nav-links a {
    padding: 1rem 2rem;
    text-decoration: none;
    color: var(--text-color);
    font-weight: 800;
  }
  .nav-links a:hover {
    transform: translateY(-2px);
  }
</style>
