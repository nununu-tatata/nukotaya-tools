---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    id: 'log-checker',
    title: 'CoC成長チェックツール',
    description: 'Tekeyやココフォリアのログから技能の成長を自動判定・集計するツールです。',
    detailText: 'Tekeyやココフォリアのログをドラッグ＆ドロップするだけで、技能の成長（CL・FB・S・初期値など）を自動判定・集計するツールです。スマホ対応！\n６版のTekey（v2）とココフォリアのログに対応。様々なオプションで好きな成長をチェックしテキスト出力可能です。',
    url: 'https://nununu-tatata.github.io/log-checker/',
    type: 'Web',
    image: 'https://nununu-tatata.github.io/log-checker/ogp.png'
  },
  {
    id: 'keypale',
    title: 'KeyPale',
    description: 'Tekey向けチャパレ編集エディタ。素早く快適にチャパレを編集。',
    detailText: 'KeyPaleはTekeyでのオンラインセッションをより快適にするためのデスクトップアプリケーションです。\n直感的な操作とショートカットキーを駆使して、チャットパレットの作成や編集を爆速で行えます。',
    url: 'https://alpha.booth.pm/items/7976314',
    type: 'BOOTH'
  },
  {
    id: 'backup-kun',
    title: 'CoC6版CS バックアップくん',
    description: '保管所のデータをスプレッドシートに自動バックアップ。',
    detailText: '現在作成中のスプレッドシートツールです。\nキャラクター保管所に登録しているCoC6版のキャラクターシートのデータを、安全にスプレッドシートにバックアップ・管理することができます。',
    url: 'https://x.com/nukonuko_4/status/2057406689859838067',
    type: 'Spreadsheet'
  },
  {
    id: '404-tool',
    title: 'CoCチャパレ＆コマ作成',
    description: 'ブラウザ上で素早くココフォリア用のコマやチャットパレットを生成。',
    detailText: 'ブラウザ上で動作するWEBツールです。\n必要なステータスを入力するだけで、ココフォリアにそのまま流し込める形式のコマデータやチャットパレットを簡単に作成できます。',
    url: 'https://nununu-tatata.github.io/404-tool/',
    type: 'Web'
  },
  {
    id: 'tecopi',
    title: 'TECOPI',
    description: 'テキスト送信支援ツール。よく使う定型文を手軽にコピペ＆送信。',
    detailText: 'TECOPI（テキスト送信支援ツール）は、セッション中によく使う描写や定型文をあらかじめ登録しておき、必要な時にワンクリックで呼び出して送信できるBOOTH配布ツールです。\nKP（キーパー）の負担を大きく軽減します。',
    url: 'https://alpha.booth.pm/items/8544644',
    type: 'BOOTH'
  }
];
---

<Layout title="ぬこた屋ツールズ (アイデア3)">
  <div class="page-title">
    <h2>💡 アイデア3: アシンメトリー・ジグザグ型</h2>
    <p>互い違いに配置されたアートギャラリーのような構成。クリックで中央に展開。</p>
  </div>

  <div class="idea3-container">
    {tools.map((tool, index) => (
      <div class={`zigzag-wrapper align-${index % 3}`}>
        <button class="z-card glass" data-target={`details-${tool.id}`}>
          <div class="z-card-content">
            <span class={`tag tag-${tool.type.toLowerCase()}`}>{tool.type}</span>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
          </div>
          {tool.image && (
            <div class="z-card-img" style={`background-image:url(${tool.image})`}></div>
          )}
        </button>
        
        <!-- 展開パネル (デフォルト非表示) -->
        <div id={`details-${tool.id}`} class="z-details glass hidden">
          <div class="z-details-inner">
            <button class="close-details" aria-label="閉じる">×</button>
            <div class="z-details-layout">
              {tool.image && (
                <div class="z-details-left">
                  <img src={tool.image} alt={tool.title} class="z-detail-image" />
                </div>
              )}
              <div class="z-details-right">
                <h2>{tool.title}</h2>
                <div class="z-detail-desc">
                  {tool.detailText.split('\n').map(line => <p>{line}</p>)}
                </div>
                <div class="z-detail-actions">
                  <a href={tool.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">公開ページへ ↗</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="nav-links">
    <a href="/idea-2" class="glass">← アイデア2に戻る</a>
    <a href="/" class="glass">トップへ戻る</a>
  </div>
</Layout>

<script>
  const cards = document.querySelectorAll('.z-card');
  const details = document.querySelectorAll('.z-details');
  let activeDetails: HTMLElement | null = null;
  let activeCard: HTMLElement | null = null;

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const targetId = card.getAttribute('data-target');
      const targetDetail = document.getElementById(targetId as string);
      const wrapper = card.closest('.zigzag-wrapper');
      
      if (activeDetails && activeDetails !== targetDetail) {
        activeDetails.classList.remove('open');
        activeCard?.classList.remove('expanded');
        activeCard?.closest('.zigzag-wrapper')?.classList.remove('expanded-wrapper');
      }

      if (targetDetail?.classList.contains('open')) {
        targetDetail.classList.remove('open');
        card.classList.remove('expanded');
        wrapper?.classList.remove('expanded-wrapper');
        activeDetails = null;
        activeCard = null;
      } else if (targetDetail) {
        targetDetail.classList.add('open');
        card.classList.add('expanded');
        wrapper?.classList.add('expanded-wrapper');
        activeDetails = targetDetail;
        activeCard = card as HTMLElement;
        
        // 中央にスクロール
        setTimeout(() => {
          wrapper?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 300);
      }
    });
  });

  const closeBtns = document.querySelectorAll('.close-details');
  closeBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (activeDetails) {
        activeDetails.classList.remove('open');
        activeCard?.classList.remove('expanded');
        activeCard?.closest('.zigzag-wrapper')?.classList.remove('expanded-wrapper');
        activeDetails = null;
        activeCard = null;
      }
    });
  });
</script>

<style>
  .page-title { text-align: center; margin-bottom: 2rem; }
  .page-title h2 { margin-bottom: 0.5rem; }

  .idea3-container {
    max-width: 900px;
    margin: 0 auto 4rem;
    padding: 0 2rem;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* ジグザグ配置 */
  .zigzag-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
    transition: all 0.5s ease;
  }
  .align-0 { align-items: flex-start; }
  .align-1 { align-items: flex-end; }
  .align-2 { align-items: center; }

  .expanded-wrapper {
    align-items: center !important; /* 展開時は中央寄せに強制 */
    margin: 2rem 0;
  }

  /* カードデザイン */
  .z-card {
    display: flex;
    width: 60%;
    min-width: 320px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 20px;
    text-align: left;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }
  .z-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
  }
  [data-theme='dark'] .z-card:hover {
    box-shadow: 0 15px 40px rgba(0,0,0,0.5);
  }
  .z-card.expanded {
    display: none; /* 展開時はカード自体を隠し、詳細パネルにバトンタッチ */
  }

  .z-card-content {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .z-card-content h3 { margin: 0.5rem 0; font-size: 1.3rem; font-weight: 800; }
  .z-card-content p { margin: 0; opacity: 0.8; font-size: 0.9rem; }

  .z-card-img {
    width: 120px;
    background-size: cover;
    background-position: center;
    border-left: 1px solid var(--glass-border);
  }

  .tag {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: white;
  }
  .tag-booth { background: var(--tag-booth); }
  .tag-web { background: var(--tag-web); }
  .tag-spreadsheet { background: var(--tag-spreadsheet); }

  /* 展開パネル */
  .z-details {
    width: 100%; /* 全幅に拡大 */
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 24px;
    overflow: hidden;
  }
  .z-details.open {
    grid-template-rows: 1fr;
    box-shadow: 0 20px 50px rgba(0,0,0,0.2);
  }
  
  .z-details-inner {
    min-height: 0;
    opacity: 0;
    transition: opacity 0.3s 0.2s;
    position: relative;
  }
  .z-details.open .z-details-inner {
    opacity: 1;
    padding: 3rem;
  }

  .close-details {
    position: absolute;
    top: 20px;
    right: 20px;
    background: transparent;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    opacity: 0.5;
  }

  .z-details-layout {
    display: flex;
    gap: 3rem;
    align-items: center;
  }
  .z-details-left { flex: 0 0 40%; }
  .z-detail-image {
    width: 100%;
    border-radius: 16px;
    border: 1px solid var(--glass-border);
  }
  .z-details-right { flex: 1; }
  .z-details-right h2 { margin: 0 0 1rem 0; font-size: 2rem; font-weight: 900; }
  .z-detail-desc p { line-height: 1.8; opacity: 0.9; margin-bottom: 1rem; }

  .z-detail-actions { margin-top: 2rem; }
  .btn {
    display: inline-block;
    padding: 1rem 2rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 800;
    transition: transform 0.2s;
  }
  .btn-primary { background: var(--text-color); color: var(--bg-gradient); }
  [data-theme='dark'] .btn-primary { background: #fff; color: #000; }

  @media (max-width: 768px) {
    .z-card { width: 100%; flex-direction: column; }
    .z-card-img { width: 100%; height: 120px; border-left: none; border-top: 1px solid var(--glass-border); }
    .z-details-layout { flex-direction: column; }
    .z-details-left { width: 100%; }
    .z-details.open .z-details-inner { padding: 1.5rem; }
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 10;
  }
  .nav-links a {
    padding: 1rem 2rem;
    text-decoration: none;
    color: var(--text-color);
    font-weight: 800;
  }
</style>
