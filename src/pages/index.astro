---
import Layout from '../layouts/Layout.astro';
import { tools } from '../data/tools';

// 無限カルーセル用に3セット分を出力する
const infiniteTools = [...tools, ...tools, ...tools];
---

<Layout title="ぬこた屋ツールズ">
  <!-- 全体を包むラッパー（ここでシフトアップを制御） -->
  <div id="main-wrapper" class="idea1-wrapper">
    
    <!-- ツール一覧 横スクロールエリア -->
    <div class="slider-wrapper">
      <button class="slider-btn prev-btn glass" aria-label="前へ">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      
      <div class="horizontal-scroll" id="tool-slider" data-count={tools.length}>
        {infiniteTools.map((tool, index) => (
          <button class="h-card glass" data-target={`details-${tool.id}`} data-index={index}>
            <div class="h-card-img" style={tool.image ? `background-image:url(${tool.image})` : 'background:rgba(0,0,0,0.05)'}></div>
            <div class="h-card-body">
              <div class="tag-group">
                <span class={`tag tag-${tool.type.toLowerCase()}`}>{tool.type}</span>
                <span class={`status-tag status-${tool.status === '公開中' ? 'active' : 'wip'}`}>{tool.status}</span>
              </div>
              <h3>{tool.title}</h3>
            </div>
          </button>
        ))}
      </div>

      <button class="slider-btn next-btn glass" aria-label="次へ">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <!-- 展開される詳細パネルエリア (1セット分のみ) -->
    <div class="details-stage">
      {tools.map((tool) => (
        <div id={`details-${tool.id}`} class="stage-panel hidden">
          <button class="close-stage" aria-label="閉じる">×</button>
          <div class="stage-layout">
            {tool.image && (
              <div class="stage-left" data-images={JSON.stringify(tool.gallery ?? [tool.image])}>
                <button class="stage-image-btn" aria-label="画像を拡大表示">
                  <img src={tool.gallery?.[0] ?? tool.image} alt={tool.title} class={`stage-image${tool.gallery ? ' has-gallery' : ''}`} />
                  <span class="zoom-hint">🔍 拡大</span>
                </button>
                {tool.gallery && (
                  <div class="stage-thumbs">
                    {tool.gallery.map((src, i) => (
                      <button class={`stage-thumb${i === 0 ? ' active' : ''}`} aria-label={`画像${i + 1}を表示`}>
                        <img src={src} alt="" loading="lazy" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            )}
            <div class="stage-right">
              <h2>{tool.title}</h2>
              <div class="tag-group" style="justify-content: flex-start; gap: 10px; margin-bottom: 1rem;">
                <span class={`tag tag-${tool.type.toLowerCase()}`}>{tool.type}</span>
                <span class={`status-tag status-${tool.status === '公開中' ? 'active' : 'wip'}`}>{tool.status}</span>
              </div>
              <div class="stage-desc">
                {tool.detailText.split('\n').map(line => <p>{line}</p>)}
              </div>
              <div class="stage-actions">
                {tool.status === '公開中' && (
                  <a href={tool.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">公開ページへ ↗</a>
                )}
                {tool.xUrl && (
                  <a href={tool.xUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">💬 X(旧Twitter)で見る</a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- リクエストバナー -->
    <div class="request-banner glass">
      <div class="request-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
        </svg>
      </div>
      <div class="request-text">
        <h4>作ってほしいツールがあったらこちら！</h4>
        <p>TRPGをもっと便利にするアイデア、大募集。お気軽にリクエストをお送りください。</p>
      </div>
      <a href="https://forms.gle/Vv5GeqkwYxQLUdhH6" target="_blank" class="btn btn-primary request-btn">リクエストを送る ↗</a>
    </div>
  </div>

  <!-- 画像の拡大表示（ライトボックス） -->
  <dialog id="lightbox">
    <div class="lb-track"></div>
    <button class="lb-close" aria-label="閉じる">×</button>
    <button class="lb-nav lb-prev" aria-label="前の画像">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="lb-nav lb-next" aria-label="次の画像">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
    <div class="lb-counter"></div>
  </dialog>
</Layout>

<script>
  // === スライダーと無限スクロール制御 ===
  const slider = document.getElementById('tool-slider');
  const wrapper = document.getElementById('main-wrapper');
  const prevBtn = document.querySelector('.prev-btn');
  const nextBtn = document.querySelector('.next-btn');

  let isHovered = false;
  let isClicked = false;
  let animationId: number;
  
  // スムーズな無限スクロールを実現するための「1セット分の幅」
  // 1セット目の先頭カードから2セット目の先頭カードまでの距離を実際に測るので、
  // ツールの数・カード幅・gap が変わっても自動で合う（画面幅が変わったら測り直す）
  let setWidth = 0;
  function measureSetWidth() {
    const count = Number(slider?.dataset.count);
    const sliderCards = slider?.querySelectorAll<HTMLElement>('.h-card');
    if (!sliderCards || !sliderCards[count]) return;
    setWidth = sliderCards[count].offsetLeft - sliderCards[0].offsetLeft;
  }
  measureSetWidth();
  window.addEventListener('resize', measureSetWidth);

  function autoScroll() {
    if (!isHovered && !isClicked && slider) {
      slider.scrollLeft += 0.8; // 流れるスピード
      // 1セット分スクロールしたら、違和感なく0に戻す（無限ループ）
      if (setWidth > 0 && slider.scrollLeft >= setWidth) {
        slider.scrollLeft = 0;
      }
    }
    animationId = requestAnimationFrame(autoScroll);
  }

  // 初期化（スクロール開始）
  if (slider) {
    animationId = requestAnimationFrame(autoScroll);
  }

  // ホバー（またはタッチ）で一時停止
  slider?.addEventListener('mouseenter', () => { isHovered = true; });
  slider?.addEventListener('mouseleave', () => { isHovered = false; });
  slider?.addEventListener('touchstart', () => { isHovered = true; });
  slider?.addEventListener('touchend', () => { isHovered = false; });

  // 矢印ボタンでの手動スクロール（クリック時は自動スクロールを一時的に止める）
  const manualScrollAmount = 300;
  prevBtn?.addEventListener('click', () => {
    slider?.scrollBy({ left: -manualScrollAmount, behavior: 'smooth' });
    isHovered = true; setTimeout(() => { isHovered = false; }, 1000);
  });
  nextBtn?.addEventListener('click', () => {
    slider?.scrollBy({ left: manualScrollAmount, behavior: 'smooth' });
    isHovered = true; setTimeout(() => { isHovered = false; }, 1000);
  });


  // === カード展開（シフトアップと吹き出し）制御 ===
  const cards = document.querySelectorAll('.h-card');
  const panels = document.querySelectorAll('.stage-panel');
  let activePanel: HTMLElement | null = null;
  let activeTargetId: string | null = null;

  cards.forEach(card => {
    card.addEventListener('click', () => {
      const targetId = card.getAttribute('data-target');
      const panel = document.getElementById(targetId as string);
      
      // 同じパネルを再度クリックしたら閉じる
      if (activeTargetId === targetId) {
        closeAll();
        return;
      }

      // 他のパネルや状態をリセット
      cards.forEach(c => c.classList.remove('active'));
      if (activePanel) activePanel.classList.remove('open');

      if (panel) {
        // 新しいパネルを開く
        panel.classList.add('open');
        // クリックしたターゲットと同じIDを持つすべてのクローンカードをアクティブにする
        cards.forEach(c => {
          if (c.getAttribute('data-target') === targetId) c.classList.add('active');
        });
        
        activePanel = panel;
        activeTargetId = targetId;

        // 自動スクロールを完全停止し、ラッパーを上部へシフト
        isClicked = true;
        wrapper?.classList.add('is-expanded');
        
        // 吹き出しのしっぽ（中央）に合うように、クリックしたカードを画面中央にスナップさせる
        setTimeout(() => {
          card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }, 50);
      }
    });
  });

  // === 詳細パネル内のギャラリー（サムネイルで大きい画像を切り替え） ===
  function selectImage(left: Element, index: number) {
    const images: string[] = JSON.parse(left.getAttribute('data-images') || '[]');
    const mainImage = left.querySelector('.stage-image') as HTMLImageElement | null;
    if (mainImage && images[index]) mainImage.src = images[index];
    left.querySelectorAll('.stage-thumb').forEach((t, i) => t.classList.toggle('active', i === index));
  }

  document.querySelectorAll('.stage-thumb').forEach(thumb => {
    thumb.addEventListener('click', () => {
      const left = thumb.closest('.stage-left');
      const index = Array.from(left?.querySelectorAll('.stage-thumb') ?? []).indexOf(thumb);
      if (left) selectImage(left, index);
    });
  });

  // === 画像の拡大表示（ライトボックス）。左右ボタン・矢印キー・スワイプでスライド ===
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbTrack = lightbox?.querySelector('.lb-track') as HTMLElement | null;
  const lbCounter = lightbox?.querySelector('.lb-counter') as HTMLElement | null;
  let lbSource: Element | null = null; // 拡大表示を開いた詳細パネルの .stage-left
  let lbCount = 0;

  function lbCurrentIndex() {
    if (!lbTrack || !lbTrack.clientWidth) return 0;
    return Math.round(lbTrack.scrollLeft / lbTrack.clientWidth);
  }

  function lbUpdateCounter() {
    if (lbCounter) lbCounter.textContent = `${lbCurrentIndex() + 1} / ${lbCount}`;
  }

  function lbGo(step: number) {
    lbTrack?.scrollBy({ left: step * lbTrack.clientWidth, behavior: 'smooth' });
  }

  document.querySelectorAll('.stage-image-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const left = btn.closest('.stage-left');
      if (!left || !lightbox || !lbTrack) return;
      const images: string[] = JSON.parse(left.getAttribute('data-images') || '[]');
      const thumbs = Array.from(left.querySelectorAll('.stage-thumb'));
      const start = Math.max(0, thumbs.findIndex(t => t.classList.contains('active')));

      lbTrack.innerHTML = images.map(src => `<div class="lb-slide"><img src="${src}" alt="" /></div>`).join('');
      lbSource = left;
      lbCount = images.length;
      lightbox.classList.toggle('single', lbCount <= 1);
      lightbox.showModal();
      lbTrack.scrollLeft = start * lbTrack.clientWidth;
      lbUpdateCounter();
    });
  });

  lbTrack?.addEventListener('scroll', lbUpdateCounter);
  lightbox?.querySelector('.lb-prev')?.addEventListener('click', () => lbGo(-1));
  lightbox?.querySelector('.lb-next')?.addEventListener('click', () => lbGo(1));
  lightbox?.querySelector('.lb-close')?.addEventListener('click', () => lightbox.close());

  lightbox?.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); lbGo(-1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); lbGo(1); }
  });

  // 画像の外側（黒い部分）をクリックしたら閉じる
  lightbox?.addEventListener('click', e => {
    const target = e.target as HTMLElement;
    if (target === lightbox || target.classList.contains('lb-slide')) lightbox.close();
  });

  // 閉じたら、最後に見ていた画像を詳細パネル側にも反映する
  lightbox?.addEventListener('close', () => {
    if (lbSource) selectImage(lbSource, lbCurrentIndex());
    lbSource = null;
  });

  const closeBtns = document.querySelectorAll('.close-stage');
  closeBtns.forEach(btn => {
    btn.addEventListener('click', closeAll);
  });

  function closeAll() {
    if (activePanel) {
      activePanel.classList.remove('open');
      cards.forEach(c => c.classList.remove('active'));
      activePanel = null;
      activeTargetId = null;
      
      // シフトアップを解除して中央に戻す
      wrapper?.classList.remove('is-expanded');
      
      // 自動スクロールを再開
      setTimeout(() => {
        isClicked = false;
      }, 500); // シフトダウンのアニメーションが終わるまで少し待つ
    }
  }
</script>

<style>
  /* 全体を包み、画面中央配置を制御するラッパー */
  .idea1-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 10;
    
    /* 初期状態は画面中央（padding-topで調整） */
    padding-top: 15vh;
    min-height: calc(100vh - 120px); /* ヘッダー分を引いた高さ */
    transition: padding-top 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 展開時は上にシフト */
  .idea1-wrapper.is-expanded {
    padding-top: 2rem;
  }

  /* スライダー外枠 */
  .slider-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 2rem;
  }

  /* 左右のスクロールボタン (PC向け) */
  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--glass-border);
    cursor: pointer;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-color);
    transition: transform 0.2s, background 0.2s;
  }
  .slider-btn:hover {
    transform: translateY(-50%) scale(1.1);
    background: rgba(0,0,0,0.05);
  }
  :global([data-theme='dark']) .slider-btn:hover {
    background: rgba(255,255,255,0.1);
  }
  .slider-btn svg { width: 24px; height: 24px; }
  .prev-btn { left: -10px; }
  .next-btn { right: -10px; }

  @media (max-width: 768px) {
    .slider-btn { display: none; }
  }

  /* 横スクロールエリア（自動スクロールのためスナップを無効化） */
  .horizontal-scroll {
    display: flex;
    align-items: center; /* カードの高さが変わっても中央揃えにする */
    overflow-x: auto;
    gap: 1.5rem;
    padding: 1rem 1rem 2rem 1rem;
    width: 100%;
    
    /* IE, Edge, Firefox向けのスクロールバー非表示 */
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  /* WebKit系のスクロールバー非表示 */
  .horizontal-scroll::-webkit-scrollbar {
    display: none;
  }

  /* ====== カードデザインの動的変化 ====== */
  .h-card {
    flex: 0 0 280px; /* カード幅 */
    height: 420px; /* 初期状態: 縦長の長方形（ポートレート） */
    display: flex;
    flex-direction: column;
    padding: 0;
    border: none;
    cursor: pointer;
    border-radius: 16px;
    text-align: left;
    outline: 2px solid transparent;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    color: inherit;
    font-family: inherit;
  }

  /* 詳細展開時のカード: 少し横長の長方形に縮む */
  .idea1-wrapper.is-expanded .h-card {
    height: 180px; /* 高さが縮むことで 280x180 の横長になる */
  }

  .h-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }
  :global([data-theme='dark']) .h-card:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }
  
  /* 他が展開されている時、非アクティブなカードは少し暗くする */
  .idea1-wrapper.is-expanded .h-card:not(.active) {
    filter: grayscale(0.5) opacity(0.6);
    transform: scale(0.95);
  }

  .h-card.active {
    outline: 3px solid var(--text-color);
    transform: scale(1.05);
    z-index: 5;
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
  }
  :global([data-theme='dark']) .h-card.active {
    box-shadow: 0 15px 40px rgba(0,0,0,0.6);
  }

  /* カード内画像 */
  .h-card-img {
    width: 100%;
    height: 300px; /* 初期状態: 大きめの画像エリア */
    background-size: cover;
    background-position: center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom: 1px solid var(--glass-border);
    transition: height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  /* 展開時のカード画像: 高さを縮めて横長カードにフィットさせる */
  .idea1-wrapper.is-expanded .h-card-img {
    height: 90px; 
  }

  /* カード内テキスト */
  .h-card-body { 
    padding: 1rem; 
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    flex: 1;
  }
  .tag-group {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }
  .h-card-body h3 { 
    margin: 0.5rem 0 0 0; 
    font-size: 1.1rem; 
    font-weight: 800; 
    transition: font-size 0.3s;
  }
  .idea1-wrapper.is-expanded .h-card-body h3 {
    font-size: 0.95rem; /* 小さくなったカードに合わせて少しフォントも縮小 */
  }
  
  .tag {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    color: white;
  }
  .tag-booth { background: var(--tag-booth); }
  .tag-web { background: var(--tag-web); }
  .tag-spreadsheet { background: var(--tag-spreadsheet); }

  .status-tag {
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 800;
    border: 1.5px solid currentColor;
    background: transparent;
  }
  .status-active { color: var(--tag-web); }
  :global([data-theme='dark']) .status-active { color: #8ec3ff; }
  
  .status-wip { color: var(--tag-spreadsheet); opacity: 0.8; }
  :global([data-theme='dark']) .status-wip { color: #5bc579; opacity: 1; }

  /* ====== 選択中のツール詳細表示（吹き出し型パネル） ====== */
  .details-stage {
    width: 100%;
    margin: 0 auto;
    max-width: 1000px;
    margin-bottom: 2rem;
  }

  .stage-panel {
    display: none;
    opacity: 0;
    animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    position: relative;
    padding: 3rem;
    margin-top: 30px; /* インジケーター用のスペース */
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }
  .stage-panel.open {
    display: block;
  }

  :global([data-theme='dark']) .stage-panel {
    background: rgba(30, 30, 30, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  /* 独立した浮遊するひし形インジケーター */
  @keyframes floatingDiamond {
    0% { transform: translateX(-50%) translateY(0) rotate(45deg); }
    100% { transform: translateX(-50%) translateY(-6px) rotate(45deg); }
  }
  .stage-panel::before {
    content: '';
    position: absolute;
    top: -24px;
    left: 50%; /* カードはスクロールで中央に来るため50%でOK */
    width: 14px;
    height: 14px;
    background: var(--text-color);
    border-radius: 3px;
    animation: floatingDiamond 0.8s infinite alternate ease-in-out;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .close-stage {
    position: absolute;
    top: 15px;
    right: 20px;
    background: transparent;
    border: none;
    color: var(--text-color); /* 指定しないとブラウザ標準の黒になり、ダークモードで見えにくい */
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.4;
    transition: opacity 0.2s, transform 0.2s;
  }
  .close-stage:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .stage-layout {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .stage-left { flex: 0 0 350px; }
  .stage-image {
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--glass-border);
  }
  /* 画像ごとに縦横比が違っても、切り替え時に高さが変わらないように固定 */
  .stage-image.has-gallery {
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }
  .stage-thumbs {
    display: flex;
    gap: 6px;
    margin-top: 8px;
  }
  .stage-thumb {
    flex: 1;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 6px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .stage-thumb:hover { opacity: 0.85; }
  .stage-thumb.active { opacity: 1; border-color: var(--text-color); }
  .stage-thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .stage-image-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
