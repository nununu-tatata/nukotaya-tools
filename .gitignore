# ビルド結果（npm run build で毎回作り直されるので保存不要）
dist/

# Astro が自動生成するファイル
.astro/

# インストールしたパッケージ（npm install でいつでも復元できる）
node_modules/

# ログファイル
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 環境変数（パスワードやAPIキーを書く場所なので絶対に公開しない）
.env
.env.production

# OSが勝手に作るファイル
.DS_Store
Thumbs.db

# エディタの設定
.idea/
